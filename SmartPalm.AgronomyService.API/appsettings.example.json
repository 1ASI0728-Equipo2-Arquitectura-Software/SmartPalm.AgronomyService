{
  "ConnectionStrings": { 
    "AgronomyDatabase": "set through ConnectionStrings__AgronomyDatabase"
  },
  "Jwt": { 
    "Issuer": "smartpalm.identity", 
    "Audience": "smartpalm.clients", 
    "Key": "set through Jwt__Key"
  },
  "RabbitMq": { 
    "Enabled": true, 
    "Uri": "set through RabbitMq__Uri",
    "Exchange": "smartpalm.events", 
    "Queue": "smartpalm.agronomy"
  },
  "Reconciliation": {
    "IdentityBaseUrl": "set through Reconciliation__IdentityBaseUrl",
    "CropBaseUrl": "set through Reconciliation__CropBaseUrl",
    "InternalBearerToken": "set through Reconciliation__InternalBearerToken only when a service bearer is required"
  }
}

